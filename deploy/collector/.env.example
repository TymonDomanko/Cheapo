# Your public site, and the same COLLECTOR_TOKEN you set on the server.
COLLECTOR_SERVER=https://groceries.example.com
COLLECTOR_TOKEN=change-me-to-a-long-random-string
# Which stores to collect from home (the ones your server can't reach).
COLLECT_STORES=woolworths,aldi
# When to collect (cron, in TZ). Run a little before the server's own refresh.
TZ=Australia/Sydney
COLLECT_CRON=0 4 * * *
