# Your public site, and this helper's token (Admin → Site settings → Helpers: shown when you add it).
COLLECTOR_SERVER=https://groceries.example.com
COLLECTOR_TOKEN=paste-the-helper-token-here
# Your site says which shops to refresh and shares out Coles pages. To only ever
# refresh some shops, list them (e.g. COLLECT_STORES=woolworths,aldi);
# COLLECT_COLES=false stops it fetching Coles pages.
#COLLECT_STORES=
#COLLECT_COLES=true
# Set: keep running and check in for work. (The time only matters for sites from before work sharing.)
TZ=Australia/Sydney
COLLECT_CRON=0 4 * * *
