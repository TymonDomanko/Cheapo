# Copy to .env and export before `npm start` (e.g. `set -a; . ./.env; set +a`).
PORT=3000
# Daily price refresh (cron syntax, local time). Leave empty to disable.
SCRAPE_CRON=15 4 * * *
# fetch (fast) or browser (real Chromium, survives stricter bot protection)
SCRAPE_MODE=fetch
# DATA_DIR=./data
# COLES_DELAY_MS=1000
# WOOLWORTHS_DELAY_MS=600
# ALDI_DELAY_MS=500
# CHROMIUM_PATH=/path/to/chrome
