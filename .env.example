# Copy to .env. Used by docker compose (env_file) or export before `npm start`.
PORT=3000

# --- Public hosting ---
NODE_ENV=production
# Number of reverse proxies in front of the app (Caddy, nginx, Fly, Render…), for client IPs and HTTPS.
TRUST_PROXY=1
# Session cookies are HTTPS-only when NODE_ENV=production; set false only for plain-http testing.
# SECURE_COOKIES=true
# Accounts with these emails become admins when they sign up (comma-separated).
ADMIN_EMAILS=you@example.com
# Set to false to stop new sign-ups (existing users can still log in).
ALLOW_SIGNUPS=true

# --- Prices ---
# Time zone for the daily refresh schedule.
TZ=Australia/Sydney
# Daily price refresh (cron syntax). Leave empty to disable.
SCRAPE_CRON=15 4 * * *
# IGA stores price independently. Users pick their own store; this is the default for
# visitors who haven't, and IGA_MAX_STORES caps how many stores' prices are collected.
IGA_STORE_ID=32600
IGA_MAX_STORES=50
# fetch (fast) or browser (real Chromium, needs Playwright; not in the Docker image)
SCRAPE_MODE=fetch

# --- Self-hosted only ---
# Lets admins auto-fill Woolworths/Coles trolleys in a browser on THIS machine. Keep off on a public server.
ENABLE_TROLLEY_FILL=false
