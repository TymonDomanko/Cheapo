# Copy to .env. Used by docker compose (env_file) or export before `npm start`.
# The port the app listens on (inside the container, with Docker).
PORT=3000
# Docker only: the port on your machine (default 3000), and which address to listen on
# (127.0.0.1 = this machine only, e.g. behind your own nginx; default all addresses).
# HOST_PORT=8080
# HOST_BIND=127.0.0.1

# --- Public hosting ---
NODE_ENV=production
# Number of reverse proxies in front of the app (Caddy, nginx, Fly, Render…), for client IPs and HTTPS.
TRUST_PROXY=1
# Session cookies are HTTPS-only when NODE_ENV=production; set false only for plain-http testing.
# SECURE_COOKIES=true
# Accounts with these emails become admins when they sign up (comma-separated).
ADMIN_EMAILS=you@example.com
# Set to false to stop new sign-ups (existing users can still log in).
ALLOW_SIGNUPS=true

# --- Prices ---
# Time zone for the daily refresh schedule.
TZ=Australia/Sydney
# Daily price refresh (cron syntax). Leave empty to disable.
SCRAPE_CRON=15 4 * * *
# IGA stores price independently. Users pick their own store; this is the default for
# visitors who haven't.
IGA_STORE_ID=32600
# Optional cap on how many IGA stores' prices are collected (each adds ~2 min to the daily
# refresh and ~1–2 MB). Unset or 0 = no limit.
# IGA_MAX_STORES=100
# fetch (fast) or browser (real Chromium, needs Playwright; not in the Docker image)
SCRAPE_MODE=fetch

# --- Self-hosted only ---
# Lets admins auto-fill Woolworths/Coles trolleys in a browser on THIS machine. Keep off on a public server.
ENABLE_TROLLEY_FILL=false

# Settings below marked [admin] can instead be set on the Admin page → Site settings.
# A value set here wins over (and locks) the Admin page.

# --- Home collector (for stores that block cloud servers) [admin] ---
# Set a long random token here and on the collector (deploy/collector). Then leave those
# stores out of the server's own crawl, e.g. SERVER_SCRAPE_STORES=coles,iga,harrisfarm
# COLLECTOR_TOKEN=
# SERVER_SCRAPE_STORES=coles,iga,harrisfarm
# The Windows/Linux collector programs: a folder of ready-made ones (the Docker image has
# them in /app/collector-exe), and where to download Node.js from when building them here.
# COLLECTOR_EXE_PREBUILT=/app/collector-exe
# NODE_DIST_MIRROR=https://nodejs.org/dist

# --- Email (password resets, email confirmation, price alerts) [admin] ---
# Setting SMTP_URL here keeps the mail password out of the database (and its backups).
# Any SMTP provider. Without it, emails appear in the admin page's outbox instead.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Grocery Price Compare <alerts@groceries.example.com>
# Public address used in email links.
# SITE_URL=https://groceries.example.com

# --- Privacy page [admin] ---
# SITE_OPERATOR=Your name or organisation
# CONTACT_EMAIL=privacy@groceries.example.com

# --- Backups (.env only: Litestream starts before the app) ---
# Daily snapshot in DATA_DIR/backups (kept 7 days). For off-site, continuous backup with
# Litestream, set an S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2…):
# LITESTREAM_BUCKET=my-grocery-backups
# LITESTREAM_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# LITESTREAM_REGION=auto
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=

# Email admins when a price refresh fails or the home collector goes quiet (default on).
# ADMIN_ALERTS=true
# COLLECTOR_CHECK_CRON=0 11 * * *
